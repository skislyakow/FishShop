# Скопируй в bot/.env и заполни. bot/.env в git не попадает.

# База REST API Strapi. Локальный dev-сервер:
STRAPI_URL=http://localhost:1337

# API-токен: админка Strapi → Settings → API Tokens (тип Read-only).
STRAPI_API_TOKEN=

# Токен Telegram-бота: @BotFather → /newbot. Показывается один раз.
TELEGRAM_TOKEN=

# Имя бота в Telegram (без @). Код его не использует, только для справки.
TELEGRAM_BOT_NAME=

# Redis: здесь живут состояния пользователей (bot/main.py).
# В WSL Ubuntu redis-server уже установлен: sudo service redis-server start
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Пусто = без пароля (стандартная настройка локального Redis).
REDIS_PASSWORD=
